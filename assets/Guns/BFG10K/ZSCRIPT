Class STBFG10K : DoomWeapon
{
  Default
  {
    Radius 20;
    Height 20;
    Weapon.Selectionorder 2800;
    Weapon.AmmoUse 5;
    Weapon.AmmoGive 40;
    Weapon.AmmoType "Cell";
    Weapon.Kickback 100;
	Weapon.SlotNumber 7;
    Inventory.Pickupmessage "You got the BFG10000!  Hell, yes!";
    Decal "BFGLightning";
    Obituary "%o was blasted by %k's BFG10K";
	Tag "BFG10K";
    +Weapon.NoAutoFire
  }

  States
  {
  Spawn:
    BFG2 A -1;
    Stop;
  Ready:
    BG2G A 0 A_StartSound("Weapons/BFG10KIdle");
    BG2G AAABBBCCCDDD 1 A_WeaponReady();
    Loop;
  Deselect:
    BG2G E 1 A_Lower();
    Loop;
  Select:
    BG2G E 1 A_Raise();
    Loop;
  Fire:
    BG2G E 20 A_StartSound("Weapons/BFG10KF");
    BG2G F 4;
    BG2G GHIJ 1;
    Goto Hold;
  Hold:
    BG2G K 2 Bright A_GunFlash();
    BG2G L 2 Bright A_FireBullets(0, 0, 1, 0, "STBFG10kShot");
    BG2G M 2 Bright;
    BG2G N 2 Bright A_ReFire();
    BG2G O 35 A_StartSound("Weapons/BFG10KCool");
    Goto Ready;
  Flash:
    TNT1 A 2 Bright A_Light1();
    TNT1 A 3 bright;
    Goto LightDone;
  }
}


Class STBFG10kShot : Actor
{
  Default
  {
    Radius 11;
    Height 8;
    Speed 20;
    Damage 160;
    DamageType "BFG10K";
    Renderstyle "Add";
    Alpha 0.75;
    SeeSound "Weapons/BFG10KX";
    AttackSound "Weapons/BFG10KX";
    +NoBlockMap
    +NoGravity
    +ActivateImpact
    +ActivatePCross
    +NoTeleport
    +PuffOnActors
    +PuffGetsOwner
    +ForceRadiusDmg
  }

  States
  {
  Spawn:
    BFE1 A 0 Bright;
    BFE1 A 3 Bright A_Explode(160, 128, XF_HURTSOURCE);
    BFE1 BCDEF 3 Bright;
    Stop;
  }
}

#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Voxel structure matching C++ side
struct Voxel {
    uint materialType;  // 0 = air, 1+ = materials
    float colorR;
    float colorG;
    float colorB;
};

// Shader Storage Buffer for voxels
layout(std430, binding = 0) buffer VoxelBuffer {
    Voxel voxels[];
};

// Uniforms
uniform vec3 gridSize;           // Grid dimensions (32, 32, 32)
uniform vec3 destructionCenter;  // Center of destruction sphere in voxel space
uniform float destructionRadius; // Radius of destruction sphere
uniform int destructionType;     // 0 = sphere, future: 1 = cube, 2 = cylinder, etc.

// Convert 3D coordinates to 1D buffer index
int coordToIndex(ivec3 coord) {
    ivec3 gridSizeInt = ivec3(gridSize);
    return coord.x + gridSizeInt.x * (coord.y + gridSizeInt.y * coord.z);
}

void main() {
    // Get the 3D coordinate of this invocation
    ivec3 voxelCoord = ivec3(gl_GlobalInvocationID.xyz);

    // Check bounds
    ivec3 gridSizeInt = ivec3(gridSize);
    if (voxelCoord.x >= gridSizeInt.x ||
        voxelCoord.y >= gridSizeInt.y ||
        voxelCoord.z >= gridSizeInt.z) {
        return;
    }

    // Get the 1D index
    int index = coordToIndex(voxelCoord);

    // Skip if already air
    if (voxels[index].materialType == 0) {
        return;
    }

    // Voxel center position (add 0.5 to get center of voxel)
    vec3 voxelPos = vec3(voxelCoord) + vec3(0.5);

    // Calculate destruction based on type
    bool shouldDestroy = false;

    if (destructionType == 0) {
        // Sphere-based destruction
        float dist = distance(voxelPos, destructionCenter);
        shouldDestroy = (dist <= destructionRadius);
    }
    // Future: Add more destruction shapes here
    // else if (destructionType == 1) { ... cube ... }
    // else if (destructionType == 2) { ... cylinder ... }

    // Destroy the voxel by setting it to air
    if (shouldDestroy) {
        voxels[index].materialType = 0;
        voxels[index].colorR = 0.0;
        voxels[index].colorG = 0.0;
        voxels[index].colorB = 0.0;
    }
}

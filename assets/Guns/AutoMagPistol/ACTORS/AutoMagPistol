actor 44AMP : Weapon
{
Inventory.PickupMessage "Picked up the .44 AMP."
weapon.ammogive1 0
weapon.ammogive2 7
weapon.ammotype1 "AutoMagLoaded"
weapon.ammotype2 "44Clip"
weapon.ammouse1 1
Weapon.KickBack 200
Weapon.SlotNumber 2
Obituary "%o was silenced by %k's .44 AMP."
Tag ".44 AMP"
+AMMO_CHECKBOTH //Added Ammo_CheckBoth so you won't end up selecting an empty weapon for no reason, unlike with Ammo_Optional.
+NOAUTOFIRE
+WEAPON.NOALERT
states
{
  Spawn:
    AUPK A -1
    stop
    Ready:
    AUMP A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"EmptyReady") //If you have no ammo left, jump to empty states.
    AUMP A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Loop
  EmptyReady:
    AUMP A 0 A_JumpIf(CountInv("AutoMagLoaded") > 0,"SlideRelease") //If you SOMEHOW get a magazine round on an empty gun, jump to slide release animation.
    AUEP A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Loop
  SlideRelease:
    AUEP A 0 A_PlaySoundEX("AUMPREL",CHAN_7)
    AUEP G 1
    AUMP F 2
    AUMP G 1
    Goto Ready
  Select:
    NULL A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"EmptySelect")
    AUMP AA 0 A_Raise
    AUMP A 1 A_Raise
    loop
  EmptySelect:
    AUEP AA 0 A_Raise
    AUEP A 1 A_Raise
    loop
  Deselect:
    NULL A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"EmptyDeselect")
    AUMP AA 0 A_Lower
    AUMP A 1 A_Lower
    loop
  EmptyDeselect:
    AUEP AA 0 A_Lower
    AUEP A 1 A_Lower
    loop
  Fire:
    NULL A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"Reload")
    NULL A 0 A_AlertMonsters
    //I wanted to do a GTA VC styled "trail of smoke", but unfortunately no go.
    //Angling the source of the shot throws off the aim.
    //So it has to be an invisible A_RailAttack.
    AUMP A 0 A_PlayWeaponSound("AUMPFIR")
    //AUMF A 1 BRIGHT A_RailAttack(frandom(45, 85),17,1,"None","None",RGF_CENTERZ|RGF_Silent|RGF_explicitangle,0,"AutoMagPuff", 1.5,-1.5,8999, 1,0,0,"AutoMagTrail",0,0,2)
    AUMF A 1 BRIGHT A_RailAttack(frandom(45, 85),0,1,"None","None",RGF_SILENT|RGF_EXPLICITANGLE,0,"AutoMagPuff", 0,0,8999, 1,0,0,none,8,0,2)
    AUMF B 1 BRIGHT
    //Visual recoil below.
    // A_SetPitch raises your view, A_Recoil pushes you back, and A_Quake shakes the screen.
    NULL A 0 A_SetPitch(Pitch -2.0)
    NULL A 0 A_Recoil(3)
    NULL A 0 A_Quake(3, 4, 0, 48576, "None")
    AUMP BC 1
    NULL A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"NoRefire") //If you have no ammo left, jump to empty recoil animation.
    AUMP DE 3
    AUMP FG 2
    AUMP A 9
    AUMP A 0 A_Refire
    Goto Ready
  NoRefire:
    AUEP DE 3
    AUEP FG 2
    AUEP A 9
    AUEP A 0 A_Refire
    Goto EmptyReady
  Reload:
    NULL A 0 A_JumpIfInventory("AutoMagLoaded", 7, "ReloadFull") // If your magazine is loaded, jump to ReloadFull state.
    NULL A 0 A_JumpIfInventory("44Clip", 1, "ReloadWork") // If you have a bullet and less than your maximum capacity, jump to ReloadWork.
    AUEP A 1 A_WeaponReady // Empty reload state. A_WeaponReady on both to keep the gun bobbing.
    Goto Ready
  ReloadFull:
    AUMP A 1 A_WeaponReady // State your gun jumps into if you hold down Reload on a full mag. Keep it like this, or add an inspect animation.
    Goto Ready
// Don't worry about messing up the tempo or anything, do your own thing with this. As long as it jumps to ReloadLoop, it should work.
  ReloadWork:
    NULL A 0 A_JumpIf(CountInv("AutoMagLoaded") == 0,"ReloadWorkEmpty") // Check for mag quantity, if zero, jump to empty reload animation.
    AUMR A 2
    NULL A 0 A_PlaySoundEX("AUMPOPN",CHAN_6)
    AUMR BCDE 1
    AUMR F 5
    AUMR G 1
    AUMR H 1
    AUMR I 1
    Goto ReloadLoop
  ReloadWorkEmpty:
    AUER A 2
    NULL A 0 A_PlaySoundEX("AUMPOPN",CHAN_6)
    AUER BCDE 1
    AUER F 5
    AUER G 1
    AUER H 1
    AUEP A 0 A_PlaySoundEX("AUMPREL",CHAN_7)
    AUER I 1
    Goto ReloadLoop
//Take one round from reserve, give one round to magazine. If your magazine is loaded, or you run out of reserve rounds, jump to ReloadFinish.
  ReloadLoop:
    NULL A 0 A_TakeInventory("44Clip", 1,TIF_NOTAKEINFINITE)
    NULL A 0 A_GiveInventory("AutoMagLoaded", 1)
    NULL A 0 A_JumpIfInventory("AutoMagLoaded", 7, "ReloadFinish")
    NULL A 0 A_JumpIfInventory("44Clip", 1, "ReloadLoop")
    Goto ReloadFinish
//Reload finish. Add fancy animation here.
  ReloadFinish:
    NULL A 0 A_PlaySoundEX("AUMPCLS",CHAN_6)
    AUMR J 3
    AUMR K 2
    AUMR LA 2
    NULL A 0 A_Refire("Fire")
      Goto Ready
    }
}

ACTOR AutoMagLoaded : Ammo
{
   +IGNORESKILL
   Inventory.Amount 0
   Inventory.MaxAmount 7
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 7
   Inventory.Icon "MAGNA0"
}

actor AutoMagTrail
{
	Scale 0.2
	Alpha 0.5
	RenderStyle "Add"
	+NOGRAVITY
	States
	{
	Spawn:
// Check if the player's close. If player's close, do not spawn.
//This comes in handy if you plan on doing Railgun attacks with projectile trails, or FastProjectile attacks with MissileTrails.
	    TNT1 A 0
		TNT1 A 1 A_CheckProximity("SpawnNone","PlayerPawn",120,1,CPXF_ANCESTOR)
	    AMSM ABCDEEEEEEEEEEE 1 Bright A_FadeOut(0.1,TRUE)
		Stop
	SpawnNone:
	    TNT1 A 1 
		Stop
		}
}

//Replace the BulletPuff inheritance with your puff base of choice, and delete XDeath state if your puff already has one.
ACTOR AutoMagPuff : BulletPuff
{ 
+NOEXTREMEDEATH 
+ALWAYSPUFF
+FORCEPAIN
+FORCEDECAL
DamageType "Bullet" 
Decal "BulletChip" 
States
{
XDeath:
TNT1 A 0
Stop
}
}

